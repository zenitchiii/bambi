rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{code} {
      function isMember() {
        return request.auth != null
          && (request.auth.uid == resource.data.memberA
            || request.auth.uid == resource.data.memberB);
      }

      // One slot claimed to self, everything else byte-identical. Covers
      // first join (old value null) and rejoin after reinstall (old value
      // set — enforced by the client's transaction assert). A stranger with
      // a guessed code can still claim; see the rejoin confirm screen.
      function claimSlot(slot) {
        let other = slot == 'memberA' ? 'memberB' : 'memberA';
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([slot])
          && request.resource.data[slot] == request.auth.uid
          && request.resource.data[other] == resource.data[other]
          && resource.data[other] != null;
      }

      function isCreate() {
        return request.auth != null
          && request.resource.data.memberA == request.auth.uid
          && request.resource.data.memberB == null;
      }

      // get is open to any signed-in user: the rejoin screen must read
      // slot names before it is a member. list stays denied so the
      // collection can't be enumerated.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isCreate();
      allow update: if isMember() || claimSlot('memberA') || claimSlot('memberB');
      allow delete: if false;
    }
  }
}
