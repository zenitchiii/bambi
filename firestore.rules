rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{code} {
      function allowedKeys() {
        return ['createdAt','memberA','memberB','profileA','profileB',
                'dateNight','notes','customEvents','lastPoke','bucketList','cycle'];
      }
      function isMember() {
        return request.auth != null
          && (request.auth.uid == resource.data.memberA
            || request.auth.uid == resource.data.memberB);
      }
      function memberUpdate() {
        let d = request.resource.data;
        let o = resource.data;
        let isA = request.auth.uid == o.memberA;
        let ownKey = isA ? 'profileA' : 'profileB';
        let partnerKey = isA ? 'profileB' : 'profileA';
        return isMember()
          && d.keys().hasOnly(allowedKeys())
          && d.memberA == o.memberA
          && d.memberB == o.memberB
          && d.get(partnerKey, null) == o.get(partnerKey, null)
          && (o.get(ownKey, {}).get('gender', null) == null
              || d.get(ownKey, {}).get('gender', null) == o.get(ownKey, {}).get('gender', null));
      }
      function claimSlot(slot) {
        let other = slot == 'memberA' ? 'memberB' : 'memberA';
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([slot])
          && request.resource.data[slot] == request.auth.uid
          && request.resource.data[slot] != resource.data[other]
          && request.resource.data[other] == resource.data[other]
          && resource.data[other] != null;
      }
      function isCreate() {
        return request.auth != null
          && request.resource.data.memberA == request.auth.uid
          && request.resource.data.memberB == null
          && request.resource.data.keys().hasOnly(allowedKeys());
      }
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isCreate();
      allow update: if memberUpdate() || claimSlot('memberA') || claimSlot('memberB');
      allow delete: if false;
    }
  }
}
