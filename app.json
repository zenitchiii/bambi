{
  "expo": {
    "name": "bambi",
    "slug": "bambi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/bunny.png",
    "scheme": "bambi",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.zenitchi.bambi",
      "adaptiveIcon": {
        "backgroundColor": "#fee6ef",
        "foregroundImage": "./src/assets/images/bunny.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/bunny.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffeef4",
          "image": "./src/assets/images/bunny.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0a73d08-cbb5-4bf8-90e6-2ddbfdc95f5e"
      }
    }
  }
}
